# Copy to `.env` for local development:  cp .env.example .env
# Every value here is a placeholder or a local default. `.env` is git-ignored and
# is where the real secrets go.

# --------------------------------------------------------------------- database
# Must match the `postgres` service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cafe_admin
DATABASE_PASSWORD=cafe_pass
DATABASE_NAME=cafe_saas

# Alternative to the five settings above. When set, it wins outright — see
# databaseConfigFromEnv() in src/tenant/connection/pg-pool.provider.ts.
# DATABASE_URL=postgres://cafe_admin:cafe_pass@localhost:5432/cafe_saas

# ----------------------------------------------------------------------- redis
# Backs the Socket.IO adapter, which is what lets a KDS display on one instance
# see order events published on another. Set this to run more than one instance.
# With it unset the app still boots, but rooms are in-memory and only work
# single-instance.
#
# The cross-instance test suite is skipped unless this is set:
#   REDIS_URL=redis://localhost:6379 npx jest src/order/realtime
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------- server
PORT=3000
NODE_ENV=development

# Connections in the shared pg pool. Ten is the default; every connection is a
# PostgreSQL backend, so raise this only for a workload that needs it.
PG_POOL_MAX=10

# ----------------------------------------------------------------------- CORS
# Which browser origins may call this API. A comma-separated list of exact
# origins, e.g.
#   CORS_ORIGINS=https://app.blisscafe.com,https://admin.blisscafe.com
#
# In production an UNSET value means "no browser origin is allowed": the API
# still serves server-to-server callers, and a deploy that forgot to configure
# this fails closed instead of opening the API to every origin. Outside
# production the default is "any origin", which is what a local client expects.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------------------------------- proxy
# Set this when the API runs behind a load balancer or ingress, so the client
# IP is read from `X-Forwarded-For` instead of the proxy's address. Without it
# every request looks like it comes from the proxy — which makes the rate
# limiter treat the whole internet as one client.
#
# `true` trusts one hop (the usual case). A number trusts that many hops.
TRUST_PROXY=false

# ----------------------------------------------------------------------- auth
# Signs access and refresh tokens.
#
# In production this variable is REQUIRED: the app refuses to start without it,
# and it refuses the development fallback and any secret shorter than 32
# characters. The fallback string is in the repository, so a deployment that
# shipped it would let anybody mint a valid token for any user.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ------------------------------------------------------------------ rate limits
# How many requests a single client may make per minute on the routes that are
# expensive to abuse. The limiter counts ATTEMPTS, not successes, so a wrong
# password counts the same as a right one.
#
# The right number depends on the deployment: a café behind a NAT shares one
# public IP, so a limit tuned for one person can lock out a whole shop. Raise
# them there rather than removing the limiter.
#
# The default limit applies to EVERY route that does not ask for a tighter one.
# The bucket is per route and per client address, so it is a floor against a
# runaway client rather than a quota for the whole café.
AUTH_LOGIN_RATE_LIMIT=20
AUTH_REFRESH_RATE_LIMIT=30
ONBOARDING_RATE_LIMIT=10
RATE_LIMIT_DEFAULT=300

# ------------------------------------------------------------------- payments
# Encrypts each tenant's gateway credentials (`tenant_payment_configs.config_encrypted`)
# with AES-256-GCM. Must be exactly 32 bytes: 64 hex characters, base64 for 32
# bytes, or 32 raw characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# If this is unset the API still boots, but configuring or reading a payment
# provider fails with a clear error — it never silently stores plaintext secrets.
PAYMENT_CONFIG_ENCRYPTION_KEY=replace-me-with-32-bytes-of-hex

# ---------------------------------------------------------------------- staff
# How many minutes before and after a scheduled shift start a clock-in is
# accepted. The window is symmetric: 30 means 08:30–09:30 for a 09:00 shift.
# A malformed or non-positive value logs a warning and falls back to 30 rather
# than refusing to start the API — see src/staff/clock-in-policy.ts.
STAFF_CLOCK_IN_WINDOW_MINUTES=30

# -------------------------------------------------------------- notifications
# Notifications use BullMQ when REDIS_URL (above) is set: jobs survive a
# restart, retries/dead letters are shared by every replica, and a send never
# runs on the request that triggered it. Without REDIS_URL the module falls
# back to an in-memory queue with the same retry/dead-letter behaviour in one
# process — development and tests only, NOT durable.
#
# A failed send is retried with exponential backoff: the first retry waits
# NOTIFICATION_RETRY_BACKOFF_MS, the next waits twice that, and so on. After
# NOTIFICATION_RETRY_ATTEMPTS total attempts the job is copied to the DLQ and is
# readable at GET /notifications/dead-letter.
NOTIFICATION_QUEUE_NAME=notifications
NOTIFICATION_DLQ_NAME=notifications-dlq
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_MS=5000

# ------------------------------------------------------------------- reporting
# The platform overview report spans every tenant, so it cannot use the
# request's RLS-scoped connection. These settings should name a role with
# BYPASSRLS (or the table owner) and are used ONLY by the reporting module.
# When they are unset the normal DATABASE_* settings are used; an RLS-subject
# fallback makes the platform report empty rather than leaking tenant data.
# PLATFORM_DATABASE_URL=postgres://platform_report:password@localhost:5432/cafe_saas
# PLATFORM_DATABASE_HOST=localhost
# PLATFORM_DATABASE_PORT=5432
# PLATFORM_DATABASE_USER=platform_report
# PLATFORM_DATABASE_PASSWORD=change-me
# PLATFORM_DATABASE_NAME=cafe_saas
PLATFORM_PG_POOL_MAX=5
