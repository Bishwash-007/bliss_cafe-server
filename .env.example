# Postgres connection used by the app at runtime.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cafe_admin
DATABASE_PASSWORD=cafe_pass
DATABASE_NAME=cafe_saas

# Redis connection for the Socket.IO adapter.
#
# Set this to run more than one instance. With it unset the app still boots, but
# WebSocket rooms live in one process's memory, so a KDS display connected to
# instance 2 will not see order events published on instance 1.
#
# The cross-instance test suite is skipped unless this is set:
#   REDIS_URL=redis://localhost:6379 npx jest src/order/realtime
REDIS_URL=redis://localhost:6379

PORT=3000
