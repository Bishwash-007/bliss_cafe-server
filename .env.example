# Copy to `.env` for local development:  cp .env.example .env
# Every value here is a placeholder or a local default. `.env` is git-ignored and
# is where the real secrets go.

# --------------------------------------------------------------------- database
# Must match the `postgres` service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cafe_admin
DATABASE_PASSWORD=cafe_pass
DATABASE_NAME=cafe_saas

# Alternative to the five settings above. When set, it wins outright — see
# databaseConfigFromEnv() in src/tenant/connection/pg-pool.provider.ts.
# DATABASE_URL=postgres://cafe_admin:cafe_pass@localhost:5432/cafe_saas

# ----------------------------------------------------------------------- redis
# Backs the Socket.IO adapter, which is what lets a KDS display on one instance
# see order events published on another. Set this to run more than one instance.
# With it unset the app still boots, but rooms are in-memory and only work
# single-instance.
#
# The cross-instance test suite is skipped unless this is set:
#   REDIS_URL=redis://localhost:6379 npx jest src/order/realtime
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------- server
PORT=3000
NODE_ENV=development

# Connections in the shared pg pool. Ten is the default; every connection is a
# PostgreSQL backend, so raise this only for a workload that needs it.
PG_POOL_MAX=10

# ----------------------------------------------------------------------- auth
# Signs access and refresh tokens.
#
# The code falls back to a hard-coded dev string when this is unset, which lets
# anyone mint a valid token for any user. Set a real value everywhere that is not
# a developer's laptop — `docker compose up` will refuse to start the API without
# one, and CD expects it as the JWT_SECRET secret.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------- staff
# How many minutes before and after a scheduled shift start a clock-in is
# accepted. The window is symmetric: 30 means 08:30–09:30 for a 09:00 shift.
# A malformed or non-positive value logs a warning and falls back to 30 rather
# than refusing to start the API — see src/staff/clock-in-policy.ts.
STAFF_CLOCK_IN_WINDOW_MINUTES=30
